{
  "name": "skill-certify-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:journey": "node --test tests/critical-journey.test.mjs",
    "a11y:axe": "npx --yes @axe-core/cli@4.10.2 http://127.0.0.1:3000/evidence --exit",
    "guard:config-secrets": "node scripts/config-secret-guard.mjs",
    "promotion:eligibility": "node scripts/promotion-eligibility.mjs --baseline",
    "eval:stage07": "node scripts/stage07-eval.mjs",
    "quality": "npm run guard:config-secrets && npm run lint && npm run typecheck && npm run test && npm run eval:stage07 && npm run build"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "picomatch": "4.0.7",
    "typescript": "^5"
  }
}
